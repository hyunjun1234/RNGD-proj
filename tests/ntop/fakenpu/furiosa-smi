#!/usr/bin/env python3
"""시험용 가짜 furiosa-smi — 실제 NPU 를 두드리지 않고, 미리 받아 둔 출력(같은 폴더)을 그대로 낸다.

환경변수 FAKE_NPU: ok(기본) | hang(60초 무응답) | none(장치 없음) | fail(종료 코드 1)
"""
import os
import sys
import time

here = os.path.dirname(os.path.abspath(__file__))
mode = os.environ.get("FAKE_NPU", "ok")
argv = sys.argv[1:]
sub = argv[0] if argv else ""
as_json = "json" in argv

if mode == "hang":
    time.sleep(60)
    sys.exit(1)
if mode == "fail":
    print("furiosa-smi: device error (fake)", file=sys.stderr)
    sys.exit(1)
if sub not in ("status", "info", "ps"):
    sys.exit(2)
if mode == "none":
    print("[]" if as_json else "")
    sys.exit(0)
name = f"{sub}.json" if as_json and sub != "ps" else f"{sub}.txt"
with open(os.path.join(here, name)) as f:
    sys.stdout.write(f.read())
